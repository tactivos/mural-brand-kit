# Required
ASANA_ACCESS_TOKEN=your_asana_personal_access_token_here

# Optional if your Asana user belongs to exactly one workspace
ASANA_WORKSPACE_GID=your_workspace_gid_here

# Optional tuning
ASANA_REPORT_DAYS_AHEAD=7
ASANA_STALE_DAYS=10

# Optional output path, relative paths are resolved from the repo root
ASANA_OUTPUT_PATH=asana-agent/output/daily-asana-summary.md
