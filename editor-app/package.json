{
  "name": "editor-app",
  "version": "0.0.1",
  "private": true,
  "description": "Mural PDF Generator editor app (Puck-based). Scaffolded per MURAL-DOC-SCHEMA.md.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:types": "tsc",
    "test:visual:setup": "playwright install chromium",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "typescript": "^5.5.0"
  }
}
