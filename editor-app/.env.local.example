# Azure OpenAI — used by /api/generate to emit MuralDoc JSON.
#
# Copy this file to `.env.local` (same directory) and fill in the real values.
# `.env.local` is gitignored at the repo root; this `.example` is committed.
#
# After editing `.env.local`, restart the Next.js dev server so the new vars
# are picked up (Next reads env at startup only).

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Resource endpoint from the Azure portal. Keep the trailing slash.
AZURE_OPENAI_ENDPOINT=https://jmoore-ai.openai.azure.com/

# One of the two keys from: Azure portal -> your resource -> Keys and Endpoint.
AZURE_OPENAI_API_KEY=

# The *deployment name* you set when you deployed the model in Azure AI Studio
# (Azure portal -> your resource -> Deployments). This is NOT the model name.
# Currently this project uses the deployment that serves GPT-5.4.
AZURE_OPENAI_DEPLOYMENT=gpt-5.4

# Azure REST API version. Match the value shown on your deployment's
# "View code" panel in Azure AI Studio. Newer models typically require a
# preview version. See:
# https://learn.microsoft.com/azure/ai-services/openai/reference
AZURE_OPENAI_API_VERSION=2025-04-01-preview
